# ==============================================================================
# ResolveFlow - Environment Variables Template
# Copy this file to .env before starting the server or client.
# NEVER commit real credentials or secrets to version control.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/resolveflow

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# LLM Orchestration
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-1.5-pro

# Client & CORS
CLIENT_URL=http://localhost:5173
